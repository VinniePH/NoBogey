# Server-side Edge Function secrets. Never prefix these with EXPO_PUBLIC_ or VITE_.
RESEND_API_KEY=replace-with-secret
BOOKING_EMAIL_FROM=NoBogey <bookings@example.com>
OUTBOX_DISPATCH_SECRET=replace-with-random-secret
BOOKING_MAINTENANCE_SECRET=replace-with-a-different-random-secret

# Supabase injects these in hosted Edge Functions. Define them only for local serve.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
