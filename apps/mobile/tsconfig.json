{
  "extends": "@nobogey/config/typescript/base",
  "compilerOptions": {
    "allowJs": true,
    "customConditions": [
      "react-native"
    ],
    "noEmit": true
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "backend/**/*.ts",
    "scripts/**/*.ts"
  ]
}
