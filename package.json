{
  "name": "nobogey",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev:mobile": "pnpm --filter @nobogey/mobile dev",
    "dev:admin": "pnpm --filter @nobogey/admin-web dev",
    "build": "turbo run build",
