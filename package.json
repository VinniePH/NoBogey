    "eslint-plugin-react-hooks": "latest",
    "turbo": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest"
  },
  "dependencies": {
    "pnpm": "^11.10.0"
  }
}
